<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Grouping Suite">

    <test name="First Group Execution">
        <groups>
            <run>
                <include name="first"/>
            </run>
        </groups>
        <classes>
            <class name="org.andersen.lab.grouping.Groups"/>
        </classes>
    </test>

    <test name="Second Group Execution">
        <groups>
            <run>
                <include name="second"/>
            </run>
        </groups>
        <classes>
            <class name="org.andersen.lab.grouping.Groups"/>
        </classes>
    </test>

</suite>